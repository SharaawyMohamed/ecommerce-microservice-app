{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "CacheSettings": {
    "ConnectionString": "redis:6379"
  },

  "GrpcSettings": {
    // [UPDATE] Changed host from "discount.grpc" to "discount.api" to match 
    // the service name in docker-compose.yml so Docker's DNS can resolve it.
    "DiscountUrl": "http://discount.api:8082"
  }
}